flowchart TD
  subgraph DATA["1. Data Layer"]
    Q["Customer email into Odoo Helpdesk (L) / Original ticket and customer records stay here"]
  end
  subgraph INT["3. Integration Layer"]
    A["Python adapter: minimise text; timeout handling / Development €3,000; no added SaaS assumed"]
    V["Validate exactly one permitted label / Invalid / timeout: preserve manual queue"]
  end
  subgraph MODEL["2. AI Model Layer"]
    B["BUILD classifier: local Llama 3.2 3B / Ollama / Hardware €1,200; power/infra allowance €240/year / €0 external token fee; capacity untested"]
  end
  subgraph UI["4. Interface Layer"]
    M["Existing manual queue / staff classification"]
    H["Odoo Helpdesk human review (L) / Approve or correct BEFORE routing / Review €3,125 + correction €937.50/year / Training €600 upfront"]
    R["Approved department routing (L) / No automated replies, refunds or ticket closure"]
  end
  subgraph GOV["5. Governance Layer"]
    G["Company audit logs: IDs, model/prompt version, label and correction / Access, retention, language/quality and cost monitoring / Maintenance/monitoring €600/year"]
  end
  Q -->|"Version-supported API / HTTPS + JSON; untrusted enquiry text + ID"| A
  A -->|"local HTTP JSON /api/chat; minimised text only"| B
  B -->|"HTTP JSON; proposed category"| V
  V -->|"Version-supported API / HTTPS + JSON; suggestion only"| H
  Q -.->|"original ticket in existing platform; manual fallback"| M
  V -.->|"failure state / invalid label; retain ticket"| M
  M -->|"staff-assigned category in platform"| H
  H -->|"human-approved category + ticket ID"| R
  A -.->|"JSON request metadata; no full email copy"| G
  V -.->|"JSON model/version/validation outcome"| G
  H -.->|"reviewer correction + final decision"| G
